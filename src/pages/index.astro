---
import Layout from '../layouts/Layout.astro';
import { projects, profiles, skillGroups, email } from '../data/portfolio';
import { notebookPhotos } from '../data/notebook';
---
<Layout>
  <main id="main">
    <section class="hero container" id="top" aria-labelledby="intro-title">
      <div class="hero-content">
        <p class="eyebrow"><span class="status-dot"></span> FULL-STACK DEVELOPER <span class="eyebrow-divider">/</span> PUNE, INDIA</p>
        <h1 id="intro-title">Hi, I’m Minesh<span class="brand-dot">.</span><br />I care about how things feel<span class="subtle">—and what people can do with them.</span></h1>
        <p class="hero-description">I’m a full-stack developer with a frontend foundation. I build websites and web apps, with attention to the details that make them easier to use.</p>
        <div class="hero-actions"><a class="button button-primary" href="#work">View work <span aria-hidden="true">↗</span></a><a class="button button-secondary" href="/Minesh-Rajput-Resume.pdf" download>Download résumé <span aria-hidden="true">↓</span></a></div>
        <div class="profile-links">{profiles.map(profile => <a href={profile.href} target={profile.label === 'Email' ? undefined : '_blank'} rel="noreferrer">{profile.label} <span aria-hidden="true">↗</span></a>)}</div>
      </div>
      <div class="hero-bottom"><span><span class="status-dot"></span> Open to full-stack opportunities</span><a href="#work">A little further down <span aria-hidden="true">↓</span></a></div>
    </section>
    <div class="content-column container">
      <section class="section" id="work" aria-labelledby="work-title">
        <div class="section-heading"><p class="eyebrow">01 / SELECTED WORK</p><span class="small-note">Personal projects & client commissions</span></div>
        <h2 id="work-title">Things I’ve built<span class="subtle">.</span></h2>
        <div class="project-grid">{projects.map(project => <article class="project">
          <a class={`project-image ${!project.image ? 'project-illustration' : ''}`} href={project.live} target="_blank" rel="noreferrer" aria-label={`Visit ${project.name} live site`}>
            {project.image ? <img src={project.image} alt={project.alt} width="1425" height="891" loading="lazy" /> : project.name === 'DropDox' ?
              <div class="file-illustration" aria-hidden="true"><div class="mini-sidebar">D<span>Files</span><span>Starred</span><span>Trash</span></div><div class="mini-files"><strong>Your files, in order.</strong><div class="file-grid"><span>↥<small>Upload</small></span><span>▤<small>Documents</small></span><span>▧<small>Images</small></span></div><p>DropDox / File storage</p></div></div> :
              <div class="architecture-illustration" aria-hidden="true"><div class="room room-one"></div><div class="room room-two"></div><div class="room room-three"></div><span>SPACE, EXPLORED.</span><small>Interactive architectural walkthrough</small></div>}
            <span class="image-open" aria-hidden="true">↗</span>
          </a>
          {!project.image && <span class="preview-caption">Illustration · Open the live experience ↗</span>}
          <div class="project-meta"><span>{project.category}</span><span>{project.number}</span></div>
          <h3>{project.name}</h3><p class="project-description">{project.description}</p>
          <p class="project-role">{project.role}</p>
          <ul class="tags" aria-label={`${project.name} technologies`}>{project.stack.map(item => <li>{item}</li>)}</ul>
          <details><summary>Behind the build <span aria-hidden="true">+</span></summary><p>{project.detail}</p></details>
          <div class="project-links"><a href={project.live} target="_blank" rel="noreferrer">Live site ↗</a><a href={project.code} target="_blank" rel="noreferrer">Source code ↗</a></div>
        </article>)}</div>
      </section>
      <section class="section" id="experience" aria-labelledby="experience-title">
        <p class="eyebrow">02 / EXPERIENCE</p><h2 id="experience-title">Built with a team.<br /><span class="subtle">Delivered in production.</span></h2>
        <div class="experience">
          <div><h3>Cognizant</h3><p>Software Developer · Client: EY</p><span class="small-note">Apr 2023 — Jul 2026</span></div>
          <div><p>Built React and TypeScript interfaces for production applications, with a focus on performance, reusable components, and localisation.</p><ul class="experience-list"><li>Improved dashboard performance by 20%, measured with Lighthouse.</li><li>Led a five-person team delivering localisation across eight languages.</li><li>Built an internal tool that reduced manual translation time by 70%.</li><li>Led the winning Cognizant Ideathon team with an AI risk-forecasting tool.</li></ul></div>
        </div>
      </section>
      <section class="section" id="skills" aria-labelledby="skills-title"><p class="eyebrow">03 / TOOLKIT</p><h2 id="skills-title">The tools behind the work<span class="subtle">.</span></h2><p class="section-intro">React and TypeScript are my foundation. I also work across APIs, databases, and deployment.</p><div class="skill-groups">{skillGroups.map(group => <div><h3>{group.title}</h3><ul>{group.items.map(item => <li>{item}</li>)}</ul></div>)}</div></section>
      <section class="section about" id="about" aria-labelledby="about-title">
        <div><p class="eyebrow">04 / A BIT ABOUT ME</p><h2 id="about-title">I like knowing<br /><span class="subtle">how it works.</span></h2><p class="small-note">Minesh Rajput / Pune, India</p></div>
        <div class="about-copy"><p>I learn best when I have something to build. My background is in frontend development, but I also work on the APIs, data, and deployment. I want to understand what happens after someone clicks the button.</p><p>That’s the part I enjoy: working through the details until the thing makes sense. Sometimes it’s getting an interface to feel right. Sometimes it’s figuring out why something doesn’t work.</p><p>Outside of code, I take photographs. Streets, people, and the things I notice along the way.</p><a class="text-link" href="/Minesh-Rajput-Resume.pdf" download>A little more on paper — my résumé ↗</a></div>
      </section>
      <section class="section" id="photography" aria-labelledby="photography-title">
        <div class="section-heading"><p class="eyebrow">05 / AWAY FROM CODE</p><a class="text-link" href="/photography/">View the notebook ↗</a></div><h2 id="photography-title">A different way of looking<span class="subtle">.</span></h2>
        <p class="section-intro">Portraits, streets, and everything in between.</p>
        <div class="photo-preview">{notebookPhotos.slice(0,3).map(photo => <a href="/photography/" aria-label="Explore the photography notebook"><img src={`/images/notebook/${photo.file}.webp`} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" /></a>)}</div>
        <a class="instagram-link text-link" href="https://www.instagram.com/kon.hu.main_09/" target="_blank" rel="noreferrer">More photographs on Instagram ↗</a>
      </section>
      <section class="section contact" id="contact" aria-labelledby="contact-title"><p class="eyebrow">06 / SAY HELLO</p><h2 id="contact-title">Something in mind?<br /><span class="subtle">Let’s talk.</span></h2><p>I’m open to full-stack roles and interesting projects.<br />Tell me a little about what you’re working on.</p><div class="contact-actions"><a class="email-link" href={`mailto:${email}`}>{email} ↗</a><button class="icon-button copy-email" data-email={email} aria-label="Copy email address" title="Copy email address">⧉</button></div><span id="copy-status" class="small-note" role="status"></span><div class="profile-links">{profiles.filter(p=>p.label!=='Email').map(p=><a href={p.href} target="_blank" rel="noreferrer">{p.label} ↗</a>)}</div></section>
    </div>
  </main>
</Layout>
