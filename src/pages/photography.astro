---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import { notebookPhotos } from '../data/notebook';
---

<Layout page="photography">
  <main id="main" class="container gallery-page">
    <div id="top"><a class="text-link" href="/#photography"><Icon name="arrow-left" /> Back to the portfolio</a><p class="eyebrow">AWAY FROM CODE / VISUAL NOTEBOOK</p><h1>A different<br />way of looking<span class="brand-dot">.</span></h1><div class="section-heading"><p class="section-intro">Portraits, streets, and everything in between.<br />A few things I stopped to notice.</p><a class="text-link" href="https://www.instagram.com/kon.hu.main_09/" target="_blank" rel="noreferrer">Instagram <Icon name="arrow-up-right" /></a></div></div>
    <div class="gallery-grid">{notebookPhotos.map((photo,index)=><button class="gallery-photo" data-photo-index={index} data-src={`/images/notebook/${photo.file}.webp`} data-caption={photo.alt} data-width={photo.width} data-height={photo.height} aria-label={`Enlarge photograph: ${photo.alt}`}><img src={`/images/notebook/${photo.file}.webp`} alt={photo.alt} width={photo.width} height={photo.height} loading={index < 3 ? 'eager' : 'lazy'} /><span aria-hidden="true">{String(index+1).padStart(2,'0')} <Icon name="arrow-up-right" /></span></button>)}</div>
    <dialog id="lightbox" aria-label="Photograph viewer"><button class="lightbox-close icon-button" aria-label="Close photograph"><Icon name="close" /></button><button class="lightbox-prev icon-button" aria-label="Previous photograph"><Icon name="arrow-left" /></button><span class="lightbox-count" aria-live="polite" aria-atomic="true"></span><figure><div class="lightbox-stage" aria-busy="false"><img id="lightbox-image" alt="" hidden /><div class="lightbox-feedback" hidden><p class="lightbox-message" role="status"></p><button class="lightbox-retry" hidden>Retry</button></div></div><figcaption id="lightbox-caption"></figcaption></figure><button class="lightbox-next icon-button" aria-label="Next photograph"><Icon name="arrow-right" /></button></dialog>
  </main>
</Layout>
