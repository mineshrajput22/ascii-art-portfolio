---
import Layout from '../layouts/Layout.astro';
import { notebookPhotos } from '../data/notebook';
---
<Layout title="Visual Notebook — Minesh Rajput" description="Portraits, streets, and landscapes. A photography notebook by Minesh Rajput.">
  <main id="main" class="container gallery-page">
    <div id="top"><a class="text-link" href="/#photography">← Back to the portfolio</a><p class="eyebrow">AWAY FROM CODE / VISUAL NOTEBOOK</p><h1>A different<br />way of looking<span class="brand-dot">.</span></h1><div class="section-heading"><p class="section-intro">Portraits, streets, and everything in between.<br />A few things I stopped to notice.</p><a class="text-link" href="https://www.instagram.com/kon.hu.main_09/" target="_blank" rel="noreferrer">Instagram ↗</a></div></div>
    <div class="gallery-grid">{notebookPhotos.map((photo,index)=><button class="gallery-photo" data-photo-index={index} data-src={`/images/notebook/${photo.file}.webp`} data-caption={photo.alt} aria-label={`Enlarge photograph: ${photo.alt}`}><img src={`/images/notebook/${photo.file}.webp`} alt={photo.alt} width={photo.width} height={photo.height} loading={index < 3 ? 'eager' : 'lazy'} /><span aria-hidden="true">{String(index+1).padStart(2,'0')} ↗</span></button>)}</div>
    <dialog id="lightbox" aria-label="Photograph viewer"><button class="lightbox-close icon-button" aria-label="Close photograph">×</button><button class="lightbox-prev icon-button" aria-label="Previous photograph">←</button><figure><img id="lightbox-image" src="" alt="" /><figcaption id="lightbox-caption"></figcaption></figure><button class="lightbox-next icon-button" aria-label="Next photograph">→</button></dialog>
  </main>
</Layout>
