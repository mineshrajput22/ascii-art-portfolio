---
import Icon from '../components/Icon.astro';
import BackToTop from '../components/BackToTop.astro';
import '../styles/global.css';
import { canonicalUrl, pageMetadata, pageStructuredData, type PageKind } from '../lib/seo';
interface Props { page?: PageKind; title?: string; description?: string; }
const { page = 'home' } = Astro.props;
const { title = pageMetadata[page].title, description = pageMetadata[page].description } = Astro.props;
const canonical = canonicalUrl(Astro.site, pageMetadata[page].path);
const site = new URL('/', canonical);
const socialImage = new URL('/social-card.png', site);
const socialAlt = 'Minesh Rajput — a frontend foundation, a full-stack perspective.';
const structuredData = JSON.stringify(pageStructuredData(site, canonical, page, title, description)).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <meta name="author" content="Minesh Rajput" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#f7f7f2" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Minesh Rajput" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialAlt} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={structuredData} />
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('minesh-theme'); } catch {}
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="ocean-backdrop" aria-hidden="true"><canvas id="ocean"></canvas></div>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Minesh Rajput home">minesh<span class="brand-dot">.</span></a>
      <nav aria-label="Main navigation">
        <a href="/#work">Work</a><a href="/#about">About</a><a href="/#contact">Contact <span aria-hidden="true"><Icon name="arrow-down" /></span></a>
      </nav>
      <div class="display-controls">
        <button id="theme-toggle" class="icon-button" aria-label="Switch color theme" title="Switch color theme"><Icon name="theme" /></button>
      </div>
    </header>
    <audio id="bg-music" src="/bg-music.m4a" loop preload="auto"></audio>
<slot />
    <footer class="site-footer container">
      <a href="/" class="wordmark">minesh<span class="brand-dot">.</span></a>
      <span>© {new Date().getFullYear()} Minesh Rajput</span>
      <a href="#top">Back to top <Icon name="arrow-up" /></a>
    </footer>
    <BackToTop />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
